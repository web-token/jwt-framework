{
    "source": {
        "directories": [
            "src"
        ]
    },
    "timeout": 3,
    "logs": {
        "text": ".ci-tools/infection.txt"
    },
    "mutators": {
        "@default": true,
        "global-ignoreSourceCodeByRegex": [
            "\\$this->logger.*",
            "\\$this->cache->save.*",
            "parent::build(\\$container);"
        ],
        "MBString": {
            "settings": {
                "mb_substr": false,
                "mb_strlen": false
            }
        }
    },
    "phpUnit": {
        "configDir": ".ci-tools"
    }
}
